# Relocatable module exports. MIT.
@PACKAGE_INIT@
set(Telemetry_VERSION "@PROJECT_VERSION@")
set(Telemetry_SOURCE_REVISION "@TELEMETRY_SOURCE_REVISION@")
include("${CMAKE_CURRENT_LIST_DIR}/TelemetryTargets.cmake")
foreach(component IN LISTS Telemetry_FIND_COMPONENTS)
    if(TARGET Telemetry::${component})
        set(Telemetry_${component}_FOUND TRUE)
    else()
        set(Telemetry_${component}_FOUND FALSE)
    endif()
endforeach()
# Optional platform components require explicit selection. Do not make a
# client-only consumer search for Qt just because its prefix also contains the
# transport libraries. A missing OPTIONAL_COMPONENT must not reject Client.
set(_telemetry_need_qt_core FALSE)
set(_telemetry_need_qt_serial FALSE)
set(_telemetry_need_qt_network FALSE)
if(qt_transport IN_LIST Telemetry_FIND_COMPONENTS AND TARGET Telemetry::qt_transport)
    set(_telemetry_need_qt_core TRUE)
endif()
if(qt_serial_transport IN_LIST Telemetry_FIND_COMPONENTS AND TARGET Telemetry::qt_serial_transport)
    set(_telemetry_need_qt_core TRUE)
    set(_telemetry_need_qt_serial TRUE)
endif()
if((qt_tcp_transport IN_LIST Telemetry_FIND_COMPONENTS AND TARGET Telemetry::qt_tcp_transport) OR
   (qt_connection IN_LIST Telemetry_FIND_COMPONENTS AND TARGET Telemetry::qt_connection))
    set(_telemetry_need_qt_core TRUE)
    set(_telemetry_need_qt_network TRUE)
endif()
if(_telemetry_need_qt_core)
    find_package(Qt6 6.12 QUIET COMPONENTS Core)
    set(_telemetry_qt_core_found FALSE)
    if(Qt6_FOUND AND TARGET Qt6::Core)
        set(_telemetry_qt_core_found TRUE)
    endif()
    if(qt_transport IN_LIST Telemetry_FIND_COMPONENTS)
        set(Telemetry_qt_transport_FOUND ${_telemetry_qt_core_found})
    endif()
    if(_telemetry_need_qt_serial)
        set(Telemetry_qt_serial_transport_FOUND FALSE)
        if(_telemetry_qt_core_found)
            find_package(Qt6 6.12 QUIET COMPONENTS SerialPort)
            if(Qt6_FOUND AND TARGET Qt6::SerialPort)
                set(Telemetry_qt_serial_transport_FOUND TRUE)
            endif()
        endif()
    endif()
    if(_telemetry_need_qt_network)
        set(_telemetry_qt_network_found FALSE)
        if(_telemetry_qt_core_found)
            find_package(Qt6 6.12 QUIET COMPONENTS Network)
            if(Qt6_FOUND AND TARGET Qt6::Network)
                set(_telemetry_qt_network_found TRUE)
            endif()
        endif()
        foreach(_component qt_tcp_transport qt_connection)
            if(_component IN_LIST Telemetry_FIND_COMPONENTS AND TARGET Telemetry::${_component})
                set(Telemetry_${_component}_FOUND ${_telemetry_qt_network_found})
            endif()
        endforeach()
    endif()
endif()
check_required_components(Telemetry)
